# Tailscale auth key (https://login.tailscale.com/admin/settings/keys)
# Recommended: "Reusable" + "Ephemeral" + a tag such as tag:sandburg.
# Leave empty = no Tailscale (e.g. for a local test with docker compose).
TS_AUTHKEY=

# Name in the tailnet (MagicDNS). Claude Code connects using this name.
TS_HOSTNAME=sandburg

# Extra arguments for "tailscale up", e.g. "--ssh" for Tailscale SSH
TS_EXTRA_ARGS=

# Token for the MCP proxy (bearer) and file server (password, user "sandburg").
# Empty = generated and stored in /workspace/.sandburg-token (stays the same
# across restarts with a volume). Allowed: A-Z a-z 0-9 . _ ~ -, min. 16 characters.
SANDBURG_TOKEN=

# Password for the VNC desktop. Empty = generated, stored in /workspace/.vnc-password
VNC_PASSWORD=

# Disabling individual services (0) saves RAM/VRAM
ENABLE_BLENDER=1
ENABLE_FREECAD=1
ENABLE_KICAD=1
ENABLE_BUILD123D=1
ENABLE_INKSCAPE=1
ENABLE_OPENMODELICA=1
ENABLE_NGSPICE=1
ENABLE_OPENECRAFT=1
ENABLE_BROWSER=1
ENABLE_COMFYUI=1
ENABLE_VNC=1
ENABLE_FILES=1

# Enable optional services (1). Both download several GB to the volume on first start.
ENABLE_VOICE=0
ENABLE_COMFYUI_3D=0
VOICE_IDLE_MINUTES=10

# OpenCode: an agent in the browser (http://<TS_HOSTNAME>:4096) as an alternative to
# Claude Code, for any LLM. All enabled MCP servers are preconfigured.
ENABLE_OPENCODE=0
# Login: user "opencode" + this password. Empty = generated, stored in
# /workspace/.opencode-password
OPENCODE_PASSWORD=
# API keys for OpenCode. Optional: a key can also be entered in the web UI
# (stored on the volume). OpenCode reads the usual variable for each provider, e.g.:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Extra startup arguments
COMFYUI_ARGS=
BLENDER_ARGS=
FREECAD_ARGS=
XVFB_RESOLUTION=1920x1080x24

# 1 = check Blender Python scripts before execution and block risky calls
BLENDER_MCP_SAFE_MODE=0

# Only for docker compose: image to pull or build (default ghcr.io/trn84/sandburg:latest)
# SANDBURG_IMAGE=

# Only for docker compose: host address the ports are published on (default 127.0.0.1).
# On a server you can reach directly (intranet, VPN), set its address there to skip
# the SSH tunnel. Everyone in that network can then reach the ports. Covers MCP (9090), files (8090), noVNC (6080) and OpenCode
# (4096), which are all protected by token or password.
# PUBLISH_ADDR=
# Same for ComfyUI (8188), separately because ComfyUI has no authentication: anyone
# who reaches the port can run workflows and install custom nodes (= run code).
# COMFYUI_PUBLISH_ADDR=
